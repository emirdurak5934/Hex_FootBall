{
  "appId": "app.edynfootball.mobile",
  "appName": "Football Match: HEX",
  "webDir": "mobile-dist",
  "loggingBehavior": "none",
  "server": {
    "hostname": "localhost",
    "iosScheme": "capacitor"
  },
  "plugins": {
    "CapacitorHttp": {
      "enabled": true
    },
    "CapacitorCookies": {
      "enabled": true
    }
  },
  "ios": {
    "contentInset": "automatic",
    "preferredContentMode": "mobile"
  }
}
